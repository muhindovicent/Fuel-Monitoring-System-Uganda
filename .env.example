NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://mafuta_app:replace-with-runtime-password@localhost:5432/mafutawatch
# Editorial media files persist in this database (Neon/PostgreSQL), not an upload directory.
# No external media-storage credentials are needed. See docs/16_MEDIA_MANAGEMENT.md.
# Only migration/maintenance commands need the schema owner account.
MIGRATION_DATABASE_URL=postgresql://mafuta_owner:replace-with-owner-password@localhost:5432/mafutawatch
# Set to verify-full for a remote PostgreSQL service; use its trusted CA.
PGSSLMODE=disable
# 0 for direct connections, 1 behind the included single reverse proxy.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
# Optional dedicated HTTPS OSRM service. Empty means manual-distance estimates.
ROUTING_URL=
# Compose database bootstrap credentials (supply strong, distinct values).
POSTGRES_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
SITE_ADDRESS=localhost
# Transactional email (email-address change verification only). Leave
# EMAIL_PROVIDER empty to disable the feature; the app then states that email
# changes are unavailable instead of pretending to send. See docs/10_OPERATIONS.md.
EMAIL_PROVIDER=
EMAIL_FROM=
# SMTP provider:
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_SECURE=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# HTTP relay provider (HTTPS required in production):
EMAIL_HTTP_URL=
EMAIL_HTTP_API_KEY=
