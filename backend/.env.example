# Copy to .env and keep credentials out of version control
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://mafuta:change_this_locally@localhost:5432/mafuta_watch
JWT_SECRET=replace_with_a_cryptographically_random_secret_of_32_or_more_characters
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Only for a one-time local administrator bootstrap; NEVER commit actual values
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
